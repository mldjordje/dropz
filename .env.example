# Server-only Resend credentials. Never prefix the API key with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM="Dropz Tattoo <rezervacije@mail.dropz.rs>"

# Replies from transactional messages and internal studio notifications.
EMAIL_REPLY_TO=ignjatovicdragannn@gmail.com
EMAIL_NOTIFY_TO=ignjatovicdragannn@gmail.com

# Server-only Vercel Web Analytics credentials used by Admin → Analitika.
# Leave WEB_ANALYTICS_TEAM_ID unset for a personal-account project.
WEB_ANALYTICS_TOKEN=your_vercel_access_token
WEB_ANALYTICS_PROJECT_ID=prj_your_project_id
# WEB_ANALYTICS_TEAM_ID=team_your_team_id
